# mooz server (apps/web). This server never needs AI or voice keys.
# Public WebSocket URL browsers and bridges use to reach LiveKit.
LIVEKIT_URL=ws://localhost:7880
# Server-to-server URL for LiveKit's API (defaults to LIVEKIT_URL with http).
# LIVEKIT_API_URL=http://livekit:7880
# Must match the keys LiveKit runs with. devkey/secret are public dev keys:
# the server refuses them unless LiveKit is on localhost.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# SQLite file for rooms and settings.
MOOZ_DB_PATH=./data/mooz.db
# The address people use to reach this app, e.g. https://meet.example.com.
# Used in the connect command, in connector links (which assistant apps call, so it must be
# HTTPS and reachable from the internet), and for same-origin checks. Recommended in production.
# When it's https, every cookie is Secure: open mooz at this address (or http://localhost).
# MOOZ_PUBLIC_URL=
