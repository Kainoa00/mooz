# mooz server (apps/web). This server never needs AI or voice keys.
# Public WebSocket URL browsers and bridges use to reach LiveKit.
LIVEKIT_URL=ws://localhost:7880
# Server-to-server URL for LiveKit's API (defaults to LIVEKIT_URL with http).
# LIVEKIT_API_URL=http://livekit:7880
# Must match the keys LiveKit runs with. devkey/secret are public dev keys:
# the server refuses them unless LiveKit is on localhost.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# The address LiveKit's media is reached at (docker-compose.yml). 127.0.0.1 works for this
# machine; to test from a phone on your network, use this machine's LAN address. For a real
# server, see docs/deploy-vps.md instead.
# LIVEKIT_NODE_IP=127.0.0.1
# SQLite file for rooms and settings.
MOOZ_DB_PATH=./data/mooz.db
# This app's public address, e.g. https://meet.example.com. Used in the connect command, in
# connector links (which assistant apps call, so it must be HTTPS and reachable from the
# internet), and for same-origin checks in older browsers. Recommended in production, where
# people open mooz at this address. When it's https, cookies are Secure, except at
# http://localhost. On a laptop it can be a tunnel's address, only so assistant apps can reach
# connector links: keep opening mooz at http://localhost:3000 (README: Connect Grok, Claude
# or ChatGPT).
# MOOZ_PUBLIC_URL=
# Ceilings across this server (defaults shown). mooz keeps no IP addresses; on a public
# server you can also rate limit by IP in your reverse proxy (optional).
# MOOZ_ROOMS_PER_MINUTE=30
# MOOZ_MAX_CONNECTORS=10000
# MOOZ_CONNECTORS_PER_MINUTE=60
