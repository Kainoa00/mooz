# Copy to deploy/.env, fill in, then: chmod 600 .env
# The two names people's browsers use (both need DNS A/AAAA records to this server).
MOOZ_DOMAIN=meet.example.com
LIVEKIT_DOMAIN=livekit.example.com

# The same addresses, as the app hands them out.
MOOZ_PUBLIC_URL=https://meet.example.com
LIVEKIT_URL=wss://livekit.example.com

# LiveKit's secret for the key "mooz": at least 32 random characters.
#   openssl rand -base64 48
LIVEKIT_API_SECRET=replace-with-the-output-of-openssl-rand-base64-48

# Optional ceilings across the server (defaults shown).
# MOOZ_ROOMS_PER_MINUTE=30
# MOOZ_MAX_CONNECTORS=10000
# MOOZ_CONNECTORS_PER_MINUTE=60
# The web image's version (deploy/compose.yaml).
# MOOZ_VERSION=0.1.0
