# HTTPS for mooz (certificates from Let's Encrypt). No access log on purpose: connector links
# carry their secret in the path (/mcp/<secret>), and LiveKit's address its token in the query.
# Caddy still logs a request that fails (the app restarting, say): those secrets are cut out of it.
{
	log default {
		format filter {
			wrap json
			request>uri regexp "(^/mcp/|access_token=)[^&/?]+" "${1}REDACTED"
		}
	}
}

{$MOOZ_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy 127.0.0.1:3000
}

{$LIVEKIT_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy 127.0.0.1:7880 {
		# Keep meetings' WebSockets open across a Caddy reload.
		stream_close_delay 5m
	}
}
