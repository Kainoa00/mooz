# mooz-agent (runs on YOUR machine). These keys never leave it.
# The brain: Claude (default) or Grok (`mooz-agent init NAME --brain grok`).
ANTHROPIC_API_KEY=
# Optional: override the Claude model used to answer.
MOOZ_CLAUDE_MODEL=
XAI_API_KEY=
# Optional: override the Grok model (default grok-4.7).
MOOZ_GROK_MODEL=
ELEVEN_API_KEY=
# ElevenLabs voice for your agent (find IDs in your ElevenLabs voice library).
MOOZ_VOICE_ID=
# Where agents keep their settings and memory (default ~/.mooz).
MOOZ_HOME=
