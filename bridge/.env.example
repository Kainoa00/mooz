# mooz-agent (runs on YOUR machine). These keys never leave it.
# The brain: Claude (default) or Grok (`mooz-agent init NAME --brain grok`).
ANTHROPIC_API_KEY=
# Optional: override the Claude model used to answer.
MOOZ_CLAUDE_MODEL=
XAI_API_KEY=
# Optional: override the Grok model (default grok-4.7).
MOOZ_GROK_MODEL=
# Optional: read GitHub issues, PRs and CI for repos added with `sources add github:owner/repo`.
# A fine-grained token with read-only access is best. Public repos work without one.
GITHUB_TOKEN=
# Voice: ElevenLabs (default), or MOOZ_VOICE=local for a speech server on your machine.
ELEVEN_API_KEY=
# ElevenLabs voice for your agent (find IDs in your ElevenLabs voice library).
MOOZ_VOICE_ID=

# Local voice: any OpenAI-compatible speech server, e.g. VoiceStudio (docs/local-voice.md).
# MOOZ_VOICE=local
# MOOZ_SPEECH_URL=http://127.0.0.1:3900/v1
# Separate servers for hearing and speaking (both default to MOOZ_SPEECH_URL):
# MOOZ_STT_URL=
# MOOZ_TTS_URL=
# MOOZ_STT_MODEL=whisper-1
# MOOZ_TTS_MODEL=tts-1
# MOOZ_TTS_VOICE=default
# MOOZ_TTS_FORMAT=pcm        # or wav
# MOOZ_TTS_RATE=24000        # the rate of raw pcm from your server
# Only if your server wants one (and then only over https, or on this machine):
# MOOZ_SPEECH_API_KEY=
# MOOZ_STT_CONCURRENCY=2     # transcriptions at once
# No AI key at all: the scripted brain with real voice, for trying local voice.
# MOOZ_BRAIN=offline
# Where agents keep their settings and memory (default ~/.mooz).
MOOZ_HOME=
